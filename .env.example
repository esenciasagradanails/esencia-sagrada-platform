# Supabase project URL — found in: Project Settings → API → Project URL
VITE_SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase anonymous key — found in: Project Settings → API → anon public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# WhatsApp group invite link — the link users open when they check the WPP checkbox
VITE_WPP_GROUP_URL=https://chat.whatsapp.com/your-invite-code
